# Global rules only — language-specific rules live in backend/.gitignore
# and frontend/.gitignore.

# Environment files (any level)
.env
.env.*
!.env.example

# Python bytecode can appear anywhere a script runs
__pycache__/

# OS junk
.DS_Store
Thumbs.db

# Editor
*.swp

# Personal editor and tool settings. Only the shared VS Code tasks
# (dev: run all) are committed.
.claude/
.vscode/*
!.vscode/tasks.json
*.code-workspace
