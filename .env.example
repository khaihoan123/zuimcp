# Copy to .env next to compose.yaml and fill in. Never commit the real .env.

# --- domains ---------------------------------------------------------------
# Two subdomains, both pointed at this server's IP with an A record.
APP_DOMAIN=app.example.com
MCP_DOMAIN=mcp.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- database --------------------------------------------------------------
POSTGRES_DB=mcp
POSTGRES_USER=mcp
POSTGRES_PASSWORD=

# --- secrets ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP. Lose it and every stored mailbox credential is unrecoverable.
CREDENTIALS_ENCRYPTION_KEY=

# --- mail defaults (override config.yaml) ----------------------------------
IMAP_HOST=mail.sunslifestyle.com
IMAP_PORT=993
SMTP_HOST=mail.sunslifestyle.com
SMTP_PORT=587
