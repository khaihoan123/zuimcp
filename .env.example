# Copy to .env next to compose.yaml and fill in. Never commit the real .env.

# --- domains ---------------------------------------------------------------
# Two subdomains, both pointed at this server's IP with an A record.
APP_DOMAIN=app.example.com
MCP_DOMAIN=mcp.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- database --------------------------------------------------------------
POSTGRES_DB=mcp
POSTGRES_USER=mcp
POSTGRES_PASSWORD=

# --- secrets ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP. Lose it and every stored mailbox credential is unrecoverable.
CREDENTIALS_ENCRYPTION_KEY=

# --- mail servers ------------------------------------------------------------
# Connecting to mail servers on private addresses (127.x, 10.x, 192.168.x...) is
# blocked so users can't probe your internal network. Set true only if your own
# mail server is on your LAN and every user of this instance is trusted.
ALLOW_PRIVATE_MAIL_HOSTS=false

# --- social sign-in (optional) ----------------------------------------------
# Leave blank to skip a provider — email/password still works either way.
# Redirect URI to register in each console: https://<APP_DOMAIN>/auth/callback/<provider>
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth Apps, not GitHub Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Gmail mailboxes (optional) ---------------------------------------------
# "Connect with Google" on the Connections page. A SEPARATE OAuth client from
# GOOGLE_CLIENT_ID above: that one only signs users in, this one asks for
# mailbox access (scope gmail.modify). Leave blank to turn Gmail off.
# Redirect URI to register: https://<APP_DOMAIN>/api/connections/gmail/oauth/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
