DATABASE_URL=postgresql://user:pass@localhost:5432/mcp_platform
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# Must exactly match the backend's RESOURCE_INDICATOR (MCP_RESOURCE_URL + MCP_PATH).
MCP_RESOURCE_INDICATOR=http://localhost:8000/mcp/email

PUBLIC_API_URL=http://localhost:8000

# --- social sign-in (optional) ----------------------------------------------
# Leave blank to skip a provider — email/password still works either way.
# Redirect URI to register in each console: http://localhost:5173/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
